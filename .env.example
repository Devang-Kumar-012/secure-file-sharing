# Supabase credentials (required for cross-device auth and password reset by email)
# Get these from: Supabase Dashboard → your project → Project Settings → API
#
# Without these variables the app still works, but accounts are saved
# in the browser's localStorage only (not shared across devices).
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
